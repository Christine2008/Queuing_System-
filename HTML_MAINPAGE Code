<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Queuing System</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <div class="logo">🏛️</div>
    <h1>Registrar<br><span>Queuing System</span></h1>

    <div class="date">Sep 19, 2025 &nbsp; | &nbsp; 10:24 AM &nbsp; | &nbsp; 👤</div>
</header>

<aside>
    <a class="active">⌂ &nbsp; Home</a>
    <a>🎟️ &nbsp; Get Queue Number</a>
    <a>⌕ &nbsp; Queue Status</a>
    <a>▣ &nbsp; Services</a>
    <a>👤 &nbsp; Profile</a>
    <a>⚙ &nbsp; Settings</a>
    <hr>
    <a>⇥ &nbsp; Log Out</a>
</aside>

<main>

    <section class="welcome">
        <div class="cap">🎓</div>
        <div>
            <h2>Welcome to the Registrar Office</h2>
            <p>Your service, our priority.</p>
        </div>
    </section>

    <section class="stats">

        <div class="card">
            <span>🎟️</span>
            <p>Now Serving</p>
            <h2>A-025</h2>
        </div>

        <div class="card">
            <span>◷</span>
            <p>Next in Line</p>
            <h2>A-026</h2>
        </div>

        <div class="card">
            <span>👥</span>
            <p>Waiting</p>
            <h2>12</h2>
        </div>

        <div class="card">
            <span>✓</span>
            <p>Completed</p>
            <h2>38</h2>
        </div>

    </section>

    <section class="bottom">

        <div class="services">
            <h2>Select a Service</h2>

            <div class="service-grid">
                <button>📄 &nbsp; Request Transcript<br>of Records <b>›</b></button>
                <button>📜 &nbsp; Request Certificate <b>›</b></button>

                <button>👤 &nbsp; Enrollment /<br>Registration <b>›</b></button>
                <button>💳 &nbsp; Payment / Assessment <b>›</b></button>

                <button>📖 &nbsp; Request School<br>Records <b>›</b></button>
                <button>••• &nbsp; Other Registrar<br>Concerns <b>›</b></button>
            </div>
        </div>

        <div class="actions">
            <h2>Queue Actions</h2>

            <button class="get">🎟️ &nbsp; Get Queue Number</button>

            <button class="check">⌕ &nbsp; Check Queue Status</button>

            <div class="notice">
                ⓘ &nbsp; Please wait for your number<br>
                &nbsp;&nbsp;&nbsp;&nbsp;to be called. Thank you!
            </div>
        </div>

    </section>

</main>

</body>
</html>
